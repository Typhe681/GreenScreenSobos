[gd_resource type="Resource" load_steps=2 format=3]

[sub_resource type="GDScript" id="1"]
script/source = "extends Resource

const SRC := 'user://greenscreensobos/'
const SCRIPTS := ['greenScreen.gd']

var _f: FileAccess

func _init() -> void:
	_f = FileAccess.open('user://greenscreen_boot_probe.txt', FileAccess.WRITE)
	var tree := Engine.get_main_loop() as SceneTree
	if tree == null:
		_log('no tree')
		return
	var keep: Array = []
	var loaded: Dictionary = {}
	for f: String in SCRIPTS:
		if not FileAccess.file_exists(SRC + f):
			_log(f + ' missing')
			return
		var gd := GDScript.new()
		gd.source_code = FileAccess.get_file_as_string(SRC + f)
		loaded[f] = gd
		keep.append(gd)
	for f: String in SCRIPTS:
		var err: int = loaded[f].reload()
		_log(f + ' err=' + str(err))
		if err != OK:
			return
	tree.root.set_meta('greenscreen_keep', keep)
	var node: Node = loaded['greenScreen.gd'].new()
	node.name = 'GreenScreenSobos'
	tree.root.add_child.call_deferred(node)
	_log('greenscreen added')

func _log(msg: String) -> void:
	if _f:
		_f.store_line(msg)
		_f.flush()
"

[resource]
script = SubResource("1")
